/**
 * Generates supabase/seed.sql from src/content/curriculum.ts.
 *   npm run seed:sql
 * Re-running is safe: rows are upserted by id.
 */
import { CURRICULUM } from "../src/content/curriculum.ts";

const q = (v: unknown) =>
  v === undefined || v === null ? "null" : typeof v === "number" || typeof v === "boolean" ? String(v) : `'${String(v).replace(/'/g, "''")}'`;
const j = (v: unknown) => (v === undefined ? "null" : `${q(JSON.stringify(v))}::jsonb`);

const out: string[] = [
  "-- AUTO-GENERATED by scripts/generate-seed.mts — edit src/content/curriculum.ts instead.",
  "begin;",
];

for (const m of CURRICULUM) {
  out.push(
    `insert into public.learning_modules (id,title,subtitle,description,emoji,color,sequence_order,difficulty_level,is_active,assumption_note) values (${[
      m.id, m.title, m.subtitle, m.description, m.emoji, m.color, m.order, m.difficulty, m.isActive, m.assumption,
    ].map(q).join(",")}) on conflict (id) do update set title=excluded.title,subtitle=excluded.subtitle,description=excluded.description,emoji=excluded.emoji,color=excluded.color,sequence_order=excluded.sequence_order,difficulty_level=excluded.difficulty_level,is_active=excluded.is_active,assumption_note=excluded.assumption_note;`,
  );
  for (const l of m.lessons) {
    out.push(
      `insert into public.lessons (id,module_id,title,instructions,content_type,sequence_order,audio_url) values (${[
        l.id, m.id, l.title, l.instructions, l.mechanic, l.order, l.audioUrl,
      ].map(q).join(",")}) on conflict (id) do update set module_id=excluded.module_id,title=excluded.title,instructions=excluded.instructions,content_type=excluded.content_type,sequence_order=excluded.sequence_order;`,
    );
    l.items.forEach((it, idx) => {
      const question = "say" in it ? it.say : "word" in it ? it.word : "sentence" in it ? it.sentence : "sound" in it ? it.sound : null;
      const answer = "answer" in it ? it.answer : "word" in it ? it.word : null;
      const options = "options" in it ? it.options : "pairs" in it ? it.pairs : null;
      out.push(
        `insert into public.learning_items (id,lesson_id,sequence_order,kind,question,answer,options,payload,image_url,audio_url) values (${[
          q(it.id), q(l.id), q(idx + 1), q(it.kind), q(question), q(answer), j(options ?? undefined), j(it), q(it.imageUrl), q(it.audioUrl),
        ].join(",")}) on conflict (id) do update set lesson_id=excluded.lesson_id,sequence_order=excluded.sequence_order,kind=excluded.kind,question=excluded.question,answer=excluded.answer,options=excluded.options,payload=excluded.payload;`,
      );
    });
  }
}
out.push("commit;");
console.log(out.join("\n"));
